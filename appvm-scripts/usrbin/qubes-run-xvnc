# Source common Qubes X related parameters
# shellcheck disable=SC1091
. /usr/bin/qubes-run-xcommon

XVNC=/usr/bin/Xvnc
OPTIONS_VNC="-SecurityTypes=None -rfbport 5900"

if [ -e /usr/lib/x86_64-linux-gnu/qubes-gui-daemon/shmoverride.so ]; then
    SHMOVERRIDE=/usr/lib/x86_64-linux-gnu/qubes-gui-daemon/shmoverride.so
elif [ -e /usr/lib64/qubes-gui-daemon/shmoverride.so ]; then
    SHMOVERRIDE=/usr/lib64/qubes-gui-daemon/shmoverride.so
fi

exec /usr/bin/qubes-gui-runuser "$DEFAULT_USER" /bin/sh -l -c "LD_PRELOAD=$SHMOVERRIDE exec /usr/bin/xinit $XSESSION qubes-session -- $XVNC :1 $OPTIONS_VNC > ~/.xvnc-errors 2>&1"
